{
  "name": "cubecenter-server",
  "version": "2.0.0",
  "private": true,
  "description": "API y servidor de CubeCenter (Express, arquitectura por capas)",
  "type": "module",
  "main": "src/server.js",
  "engines": { "node": ">=20.6" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon --watch src src/server.js",
    "setup:env": "node scripts/generate-env.js",
    "test": "node --test tests/",
    "lint": "eslint .",
    "format": "prettier --write .",
    "audit:deps": "npm audit --omit=dev"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "memorystore": "^1.6.7",
    "morgan": "^1.10.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.4.2"
  }
}
