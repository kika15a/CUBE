# Copia este archivo a .env (o ejecuta: npm run setup:env). NUNCA subas .env a Git.
NODE_ENV=development
PORT=3000
# Mínimo 32 caracteres aleatorios. Genera uno con: npm run setup:env
SESSION_SECRET=
# Origen del front (Vite en desarrollo). Debe coincidir EXACTO con la URL del navegador
CLIENT_ORIGIN=http://localhost:5173
# Costo de bcrypt (10-14). 12 es un buen equilibrio seguridad/rendimiento
BCRYPT_ROUNDS=12
# Pon 1 si estás detrás de un proxy inverso (Nginx, Render, Railway...)
TRUST_PROXY=0
